        "class Нода:\n",
        "    def __init__(self, число):\n",
        "        self.значение = число\n",
        "        self.левый = None\n",
        "        self.правый = None\n",
        "\n",
        "class Дерево:\n",
        "    def __init__(self):\n",
        "        self.корень = None\n",
        "\n",
        "    def добавить(self, число):\n",
        "        if self.корень is None:\n",
        "            self.корень = Нода(число)\n",
        "            return\n",
        "\n",
        "        текущий = self.корень\n",
        "        while True:\n",
        "            if число < текущий.значение:\n",
        "                if текущий.левый is None:\n",
        "                    текущий.левый = Нода(число)\n",
        "                    break\n",
        "                else:\n",
        "                    текущий = текущий.левый\n",
        "            else:\n",
        "                if текущий.правый is None:\n",
        "                    текущий.правый = Нода(число)\n",
        "                    break\n",
        "                else:\n",
        "                    текущий = текущий.правый\n",
        "\n",
        "    def показать_дерево(self):\n",
        "        def рисовать(нода, уровень=0, сторона=\"корень\"):\n",
        "            if нода is not None:\n",
        "                рисовать(нода.правый, уровень + 1, \"правый\")\n",
        "                print(\"   \" * уровень + f\"{нода.значение} ({сторона})\")\n",
        "                рисовать(нода.левый, уровень + 1, \"левый\")\n",
        "\n",
        "        рисовать(self.корень)\n",
        "\n",
        "дерево = Дерево()\n",
        "\n",
        "числа = [17, 6, 8, 20 , 13, 11, 4, 7, 19, 100, 1 ,27, 5]\n",
        "\n",
        "print(\"Добавляем числа по очереди:\")\n",
        "for число in числа:\n",
        "    дерево.добавить(число)\n",
        "    print(f\"Добавили {число}:\")\n",
        "    дерево.показать_дерево()\n",
